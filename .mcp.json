{
  "mcpServers": {
    "genkit": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "genkit-cli@1.45.0", "mcp"]
    },
    "cloud-run": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@google-cloud/cloud-run-mcp@1.12.0"]
    },
    "gcloud": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@google-cloud/gcloud-mcp@0.5.3"]
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.7.3"]
    }
  }
}
