{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://familyxpense.app/a2ui/catalogs/xpense/v1/catalog.json",
  "protocolVersion": "1.0",
  "title": "Xpense (WP-S1 sizing draft)",
  "catalogId": "https://familyxpense.app/a2ui/catalogs/xpense/v1/catalog.json",
  "components": {
    "Column": {
      "type": "object",
      "description": "A layout component that arranges its children vertically. To create a grid layout, nest Rows within this Column.",
      "properties": {
        "component": {
          "const": "Column"
        },
        "children": {
          "description": "Defines the children. Use an array of strings for a fixed set of children, or a template object to generate children from a data list. Children cannot be defined inline, they must be referred to by ID.",
          "$ref": "common_types.json#/$defs/ChildList"
        },
        "justify": {
          "type": "string",
          "description": "Defines the arrangement of children along the main axis (vertically). Use 'spaceBetween' to push items to the edges (e.g. header at top, footer at bottom), or 'start'/'end'/'center' to pack them together.",
          "enum": [
            "start",
            "center",
            "end",
            "spaceBetween",
            "spaceAround",
            "spaceEvenly",
            "stretch"
          ],
          "default": "start"
        },
        "align": {
          "type": "string",
          "description": "Defines the alignment of children along the cross axis (horizontally). This is similar to the CSS 'align-items' property.",
          "enum": [
            "center",
            "end",
            "start",
            "stretch"
          ],
          "default": "stretch"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "component",
        "children"
      ]
    },
    "Row": {
      "type": "object",
      "description": "A layout component that arranges its children horizontally. To create a grid layout, nest Columns within this Row.",
      "properties": {
        "component": {
          "const": "Row"
        },
        "children": {
          "description": "Defines the children. Use an array of strings for a fixed set of children, or a template object to generate children from a data list. Children cannot be defined inline, they must be referred to by ID.",
          "$ref": "common_types.json#/$defs/ChildList"
        },
        "justify": {
          "type": "string",
          "description": "Defines the arrangement of children along the main axis (horizontally). Use 'spaceBetween' to push items to the edges, or 'start'/'end'/'center' to pack them together.",
          "enum": [
            "center",
            "end",
            "spaceAround",
            "spaceBetween",
            "spaceEvenly",
            "start",
            "stretch"
          ],
          "default": "start"
        },
        "align": {
          "type": "string",
          "description": "Defines the alignment of children along the cross axis (vertically). This is similar to the CSS 'align-items' property, but uses camelCase values (e.g., 'start').",
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ],
          "default": "stretch"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "component",
        "children"
      ]
    },
    "List": {
      "type": "object",
      "properties": {
        "component": {
          "const": "List"
        },
        "children": {
          "description": "Defines the children. Use an array of strings for a fixed set of children, or a template object to generate children from a data list.",
          "$ref": "common_types.json#/$defs/ChildList"
        },
        "direction": {
          "type": "string",
          "description": "The direction in which the list items are laid out.",
          "enum": [
            "vertical",
            "horizontal"
          ],
          "default": "vertical"
        },
        "align": {
          "type": "string",
          "description": "Defines the alignment of children along the cross axis.",
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ],
          "default": "stretch"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "component",
        "children"
      ]
    },
    "Text": {
      "type": "object",
      "properties": {
        "component": {
          "const": "Text"
        },
        "text": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "The text content to display. While simple Markdown formatting is supported (i.e. without HTML, images, or links), utilizing dedicated UI components is generally preferred for a richer and more structured presentation."
        },
        "variant": {
          "type": "string",
          "description": "A hint for the base text style.",
          "enum": [
            "caption",
            "body"
          ],
          "default": "body"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "component",
        "text"
      ]
    },
    "Divider": {
      "type": "object",
      "properties": {
        "component": {
          "const": "Divider"
        },
        "axis": {
          "type": "string",
          "description": "The orientation of the divider.",
          "enum": [
            "horizontal",
            "vertical"
          ],
          "default": "horizontal"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": [
        "component"
      ]
    },
    "Button": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/Checkable"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Button"
            },
            "child": {
              "$ref": "common_types.json#/$defs/Child",
              "description": "The ID of the child component. Use a 'Text' component for a labeled button. Only use an 'Icon' if the requirements explicitly ask for an icon-only button."
            },
            "variant": {
              "type": "string",
              "description": "A hint for the button style. If omitted, a default button style is used. 'primary' indicates this is the main call-to-action button. 'borderless' means the button has no visual border or background, making its child content appear like a clickable link.",
              "enum": [
                "default",
                "primary",
                "borderless"
              ],
              "default": "default"
            },
            "action": {
              "$ref": "common_types.json#/$defs/Action"
            },
            "weight": {
              "$ref": "#/$defs/Weight"
            }
          },
          "required": [
            "component",
            "child",
            "action"
          ]
        }
      ]
    },
    "TextField": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/Checkable"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "TextField"
            },
            "label": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "The text label for the input field."
            },
            "value": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "The value of the text field."
            },
            "placeholder": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "The placeholder text for the input field."
            },
            "variant": {
              "type": "string",
              "description": "The type of input field to display.",
              "enum": [
                "longText",
                "number",
                "shortText",
                "obscured"
              ],
              "default": "shortText"
            },
            "weight": {
              "$ref": "#/$defs/Weight"
            }
          },
          "required": [
            "component",
            "label",
            "value"
          ]
        }
      ]
    },
    "DateTimeInput": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/Checkable"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "DateTimeInput"
            },
            "value": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "The selected date and/or time value in ISO 8601 format. If not yet set, initialize with an empty string."
            },
            "enableDate": {
              "type": "boolean",
              "description": "If true, allows the user to select a date.",
              "default": false
            },
            "enableTime": {
              "type": "boolean",
              "description": "If true, allows the user to select a time.",
              "default": false
            },
            "min": {
              "allOf": [
                {
                  "$ref": "common_types.json#/$defs/DynamicString"
                },
                {
                  "if": {
                    "type": "string"
                  },
                  "then": {
                    "oneOf": [
                      {
                        "format": "date"
                      },
                      {
                        "format": "time"
                      },
                      {
                        "format": "date-time"
                      }
                    ]
                  }
                }
              ],
              "description": "The minimum allowed date/time in ISO 8601 format."
            },
            "max": {
              "allOf": [
                {
                  "$ref": "common_types.json#/$defs/DynamicString"
                },
                {
                  "if": {
                    "type": "string"
                  },
                  "then": {
                    "oneOf": [
                      {
                        "format": "date"
                      },
                      {
                        "format": "time"
                      },
                      {
                        "format": "date-time"
                      }
                    ]
                  }
                }
              ],
              "description": "The maximum allowed date/time in ISO 8601 format."
            },
            "label": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "The text label for the input field."
            },
            "weight": {
              "$ref": "#/$defs/Weight"
            }
          },
          "required": [
            "component",
            "value"
          ]
        }
      ]
    },
    "EntryList": {
      "type": "object",
      "description": "Money entries the user is about to save, one slip per draft. Bind drafts to $/drafts. The phone owns editing and saving.",
      "properties": {
        "component": {
          "const": "EntryList"
        },
        "drafts": {
          "$ref": "common_types.json#/$defs/DynamicValue",
          "description": "Array of EntryDraft objects, normally bound to $/drafts."
        },
        "status": {
          "type": "string",
          "enum": [
            "review",
            "saved"
          ],
          "default": "review",
          "description": "review until the phone saves."
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Short heading, e.g. 'I found two things in that'."
        }
      },
      "required": [
        "component",
        "drafts"
      ]
    },
    "ChoicePrompt": {
      "type": "object",
      "description": "One question with 2 to 5 tappable answers. A pick writes value locally; action fires only when the agent must react.",
      "properties": {
        "component": {
          "const": "ChoicePrompt"
        },
        "question": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "The question."
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "description": "Answers.",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "hint": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "value"
            ]
          }
        },
        "value": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Writable binding where the picked value is stored, e.g. $/drafts/0/intent."
        },
        "allowOther": {
          "type": "boolean",
          "description": "Adds 'Other...' with a text field."
        },
        "action": {
          "$ref": "common_types.json#/$defs/Action",
          "description": "Fired after a pick, only when the agent must react."
        }
      },
      "required": [
        "component",
        "question",
        "options",
        "value"
      ]
    },
    "Transcript": {
      "type": "object",
      "description": "What was heard from a voice note.",
      "properties": {
        "component": {
          "const": "Transcript"
        },
        "text": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "The transcript."
        },
        "seconds": {
          "$ref": "common_types.json#/$defs/DynamicNumber",
          "description": "Recording length in seconds."
        }
      },
      "required": [
        "component",
        "text"
      ]
    },
    "ReceiptSummary": {
      "type": "object",
      "description": "Result of a receipt scan with split-by-category switch. The phone owns saving.",
      "properties": {
        "component": {
          "const": "ReceiptSummary"
        },
        "receipt": {
          "$ref": "common_types.json#/$defs/DynamicValue",
          "description": "Receipt object {merchant, occurredOn, currency, totalMinor, lines[]}, normally $/receipt."
        },
        "drafts": {
          "$ref": "common_types.json#/$defs/DynamicValue",
          "description": "Array of EntryDraft, one per category group."
        },
        "split": {
          "$ref": "common_types.json#/$defs/DynamicBoolean",
          "description": "Writable boolean for the split switch, e.g. $/ui/split."
        },
        "source": {
          "type": "string",
          "enum": [
            "device",
            "cloud"
          ],
          "description": "Where the receipt was read."
        }
      },
      "required": [
        "component",
        "receipt",
        "drafts",
        "split"
      ]
    },
    "SavedNote": {
      "type": "object",
      "description": "A one-line confirmation.",
      "properties": {
        "component": {
          "const": "SavedNote"
        },
        "text": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "The line."
        },
        "tone": {
          "type": "string",
          "enum": [
            "ok",
            "info",
            "warn"
          ],
          "description": "Tone."
        }
      },
      "required": [
        "component",
        "text"
      ]
    },
    "MoneyText": {
      "type": "object",
      "description": "An amount formatted by the phone. Never format money as text yourself.",
      "properties": {
        "component": {
          "const": "MoneyText"
        },
        "amountMinor": {
          "$ref": "common_types.json#/$defs/DynamicNumber",
          "description": "Integer minor units."
        },
        "currency": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "USD or IQD."
        },
        "size": {
          "type": "string",
          "enum": [
            "hero",
            "large",
            "body",
            "small"
          ],
          "description": "Size."
        },
        "sign": {
          "type": "string",
          "enum": [
            "none",
            "plus",
            "minus"
          ],
          "description": "Sign."
        },
        "tone": {
          "type": "string",
          "enum": [
            "ink",
            "income",
            "muted",
            "loan",
            "saving"
          ],
          "description": "Tone."
        },
        "approx": {
          "$ref": "common_types.json#/$defs/DynamicValue",
          "description": "Converted value {amountMinor, currency} shown beneath."
        }
      },
      "required": [
        "component",
        "amountMinor",
        "currency"
      ]
    },
    "LedgerRow": {
      "type": "object",
      "description": "Dot, label, dotted leader and a mono amount.",
      "properties": {
        "component": {
          "const": "LedgerRow"
        },
        "label": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Label."
        },
        "amountMinor": {
          "$ref": "common_types.json#/$defs/DynamicNumber",
          "description": "Integer minor units."
        },
        "currency": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "USD or IQD."
        },
        "dot": {
          "type": "string",
          "enum": [
            "income",
            "spent",
            "saved",
            "loan",
            "neutral"
          ],
          "description": "Dot colour key."
        }
      },
      "required": [
        "component",
        "label",
        "amountMinor",
        "currency"
      ]
    },
    "MiniBars": {
      "type": "object",
      "description": "Thin daily bar chart.",
      "properties": {
        "component": {
          "const": "MiniBars"
        },
        "values": {
          "$ref": "common_types.json#/$defs/DynamicValue",
          "description": "Bar values."
        },
        "caption": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Caption, e.g. avg 210/day."
        },
        "highlight": {
          "type": "string",
          "enum": [
            "last",
            "max",
            "none"
          ],
          "description": "Highlighted bar."
        },
        "description": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Required spoken summary for VoiceOver."
        }
      },
      "required": [
        "component",
        "values",
        "description"
      ]
    },
    "BreakdownList": {
      "type": "object",
      "description": "Totals by category, account or person.",
      "properties": {
        "component": {
          "const": "BreakdownList"
        },
        "items": {
          "$ref": "common_types.json#/$defs/DynamicValue",
          "description": "Array of {label, amountMinor, share, colorKey?}."
        },
        "currency": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Currency."
        },
        "totalLabel": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Total label."
        }
      },
      "required": [
        "component",
        "items",
        "currency"
      ]
    },
    "TransactionList": {
      "type": "object",
      "description": "Up to 20 transactions; tapping opens one on the phone.",
      "properties": {
        "component": {
          "const": "TransactionList"
        },
        "items": {
          "$ref": "common_types.json#/$defs/DynamicValue",
          "description": "Array of {txnId, title, subtitle, amountMinor, currency, type, occurredOn}."
        },
        "emptyText": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Shown when empty."
        }
      },
      "required": [
        "component",
        "items"
      ]
    },
    "BudgetMeter": {
      "type": "object",
      "description": "Spent against a monthly limit.",
      "properties": {
        "component": {
          "const": "BudgetMeter"
        },
        "label": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Label."
        },
        "spentMinor": {
          "$ref": "common_types.json#/$defs/DynamicNumber",
          "description": "Spent, minor units."
        },
        "limitMinor": {
          "$ref": "common_types.json#/$defs/DynamicNumber",
          "description": "Limit, minor units."
        },
        "currency": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Currency."
        }
      },
      "required": [
        "component",
        "label",
        "spentMinor",
        "limitMinor",
        "currency"
      ]
    },
    "LoanCard": {
      "type": "object",
      "description": "A loan given or taken.",
      "properties": {
        "component": {
          "const": "LoanCard"
        },
        "personName": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Counterparty."
        },
        "direction": {
          "type": "string",
          "enum": [
            "given",
            "taken"
          ],
          "description": "Direction."
        },
        "outstandingMinor": {
          "$ref": "common_types.json#/$defs/DynamicNumber",
          "description": "Outstanding."
        },
        "principalMinor": {
          "$ref": "common_types.json#/$defs/DynamicNumber",
          "description": "Principal."
        },
        "currency": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Currency."
        },
        "dueOn": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Due date YYYY-MM-DD."
        },
        "loanId": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Loan id; enables repayment and opening."
        }
      },
      "required": [
        "component",
        "personName",
        "direction",
        "outstandingMinor",
        "principalMinor",
        "currency"
      ]
    },
    "GoalCard": {
      "type": "object",
      "description": "A savings goal.",
      "properties": {
        "component": {
          "const": "GoalCard"
        },
        "name": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Goal name."
        },
        "savedMinor": {
          "$ref": "common_types.json#/$defs/DynamicNumber",
          "description": "Saved."
        },
        "targetMinor": {
          "$ref": "common_types.json#/$defs/DynamicNumber",
          "description": "Target."
        },
        "currency": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Currency."
        },
        "pace": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Pace line."
        },
        "goalId": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Goal id."
        }
      },
      "required": [
        "component",
        "name",
        "savedMinor",
        "targetMinor",
        "currency"
      ]
    },
    "Nudge": {
      "type": "object",
      "description": "A proactive line with one action.",
      "properties": {
        "component": {
          "const": "Nudge"
        },
        "text": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "The line."
        },
        "kind": {
          "type": "string",
          "enum": [
            "bill",
            "budget",
            "loan",
            "rate",
            "report",
            "info"
          ],
          "description": "Kind."
        },
        "actionLabel": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Action label."
        },
        "action": {
          "$ref": "common_types.json#/$defs/Action",
          "description": "Fired on tap."
        }
      },
      "required": [
        "component",
        "text",
        "kind"
      ]
    },
    "SuggestionChips": {
      "type": "object",
      "description": "Up to 4 follow-up suggestions; tapping sends message as the next user text.",
      "properties": {
        "component": {
          "const": "SuggestionChips"
        },
        "options": {
          "type": "array",
          "maxItems": 4,
          "description": "Suggestions.",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "message"
            ]
          }
        }
      },
      "required": [
        "component",
        "options"
      ]
    },
    "Notice": {
      "type": "object",
      "description": "Errors and limits in plain words.",
      "properties": {
        "component": {
          "const": "Notice"
        },
        "text": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "The text."
        },
        "kind": {
          "type": "string",
          "enum": [
            "offline",
            "limit",
            "privacy",
            "error"
          ],
          "description": "Kind."
        },
        "actionLabel": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Action label."
        },
        "action": {
          "$ref": "common_types.json#/$defs/Action",
          "description": "Fired on tap."
        }
      },
      "required": [
        "component",
        "text",
        "kind"
      ]
    }
