{
  "name": "xpense-firebase-rules",
  "private": true,
  "description": "Firestore and Storage rules tests for Family Xpense (run against the emulator only).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "firebase emulators:exec --project xpense-dev --config firebase.rules-test.json --only firestore,storage \"node --test --test-concurrency=1 'test/*.test.js'\"",
    "test:only": "node --test --test-concurrency=1 'test/*.test.js'"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.4.0",
    "firebase-tools": "15.37.0"
  }
}
